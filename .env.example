# Optional, free tiers without a card (see clients.PROVIDERS): models written "groq/..." etc. run only when set.
# PUT REAL KEYS IN .env, NEVER IN THIS FILE (it is committed to a public repository).
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
NVIDIA_API_KEY=
